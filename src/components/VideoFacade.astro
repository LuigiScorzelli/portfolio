---
// Click-to-load YouTube video (D12): until the click the page loads only the
// poster, no YouTube script and no cookies. On click it swaps in a
// youtube-nocookie iframe and sends the video_play event.
interface Props {
  youtubeId: string;
  title: string; // what the video is, for the button label and the iframe
  duration?: string; // e.g. "60 secondi"
  poster?: string; // local image; without it a dark placeholder is shown
  posterAlt?: string;
  trackPos?: string;
  class?: string;
}

const {
  youtubeId,
  title,
  duration,
  poster,
  posterAlt = "",
  trackPos = youtubeId,
  class: className,
} = Astro.props;

const label = duration ? `Guarda il video: ${title}, ${duration}` : `Guarda il video: ${title}`;
---

<div class:list={["video-facade", className]} data-video-facade data-youtube-id={youtubeId} data-title={title}>
  <button type="button" class="video-facade__button" aria-label={label} data-track="video_play" data-track-pos={trackPos}>
    {
      poster ? (
        <img src={poster} alt={posterAlt} loading="lazy" decoding="async" width="1600" height="900" />
      ) : (
        <span class="video-facade__placeholder" aria-hidden="true" />
      )
    }
    <span class="video-facade__play" aria-hidden="true">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>
    </span>
    {duration && <span class="video-facade__duration" aria-hidden="true">{duration}</span>}
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-video-facade]").forEach((box) => {
    box.querySelector("button")?.addEventListener(
      "click",
      () => {
        const iframe = document.createElement("iframe");
        iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(box.dataset.youtubeId ?? "")}?autoplay=1&rel=0`;
        iframe.title = box.dataset.title ?? "Video";
        iframe.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
        iframe.allowFullscreen = true;
        iframe.className = "video-facade__iframe";
        box.replaceChildren(iframe);
        iframe.focus();
      },
      { once: true }
    );
  });
</script>

<style>
  .video-facade {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--color-ink);
    box-shadow: var(--shadow-media);
  }
  .video-facade__button {
    all: unset;
    position: absolute;
    inset: 0;
    cursor: pointer;
    display: block;
  }
  .video-facade__button:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: -3px;
  }
  .video-facade__button img,
  .video-facade__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .video-facade__placeholder {
    background: linear-gradient(135deg, var(--color-dark-surface), var(--color-ink));
  }
  .video-facade__play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 72px;
    height: 72px;
    margin: -36px 0 0 -36px;
    border-radius: var(--radius-pill);
    background: #ffffff;
    color: var(--color-ink);
    display: grid;
    place-items: center;
    transition: transform 0.15s ease;
  }
  .video-facade__button:hover .video-facade__play {
    transform: scale(1.06);
  }
  .video-facade__duration {
    position: absolute;
    right: 14px;
    bottom: 14px;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: rgba(17, 22, 27, 0.8);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .video-facade :global(.video-facade__iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
